# Copy to .env (or .env.local) and adjust. Both are gitignored.
# Values here are read at build time and baked into the bundle.

# Base URL of the Drawdy backend that proxies Klipy search
# (GET /api/klipy/gifs). No trailing slash needed — it gets stripped.
# This is the production default; unset or empty resolves to the same URL.
DRAWDY_API_BASE=https://backend.drawdy.io

# Point at a local backend instead while developing:
# DRAWDY_API_BASE=http://localhost:3001
